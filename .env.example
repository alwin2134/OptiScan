# OptiScan Backend Environment Configuration Template
# Copy this file to .env and customize for your local setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# AI Vision Provider Configuration
# Options: "mock" (default for offline dev & demos), "gemini", "openai"
VISION_PROVIDER=mock
VISION_API_KEY=your_api_key_here_do_not_commit
VISION_MODEL_NAME=gemini-1.5-flash

# Image Quality & Validation Thresholds
MAX_UPLOAD_SIZE_BYTES=10485760
BLUR_THRESHOLD=12.0
MIN_IMAGE_DIMENSION=64

# Android Emulator Networking Reference
# 10.0.2.2 connects from the standard Android emulator to localhost on host machine
OPTISCAN_BACKEND_URL=http://10.0.2.2:8000/
