# OptiScan Backend Environment Configuration Template
# Copy this file to backend/.env and customize for your local setup

# Application Settings
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# CORS Configuration (comma-separated or JSON list for allowed origins)
# CORS_ORIGINS=["http://localhost:8000","http://10.0.2.2:8000","http://127.0.0.1:8000"]

# AI Vision Provider Configuration
# Options:
#   - "mock": Default offline simulation provider (ideal for unit testing and offline hackathon demos).
#   - "gemini": Google Gemini Multimodal REST API (requires VISION_API_KEY).
#   - "openai": OpenAI GPT-4o Vision API (placeholder/future).
VISION_PROVIDER=mock

# Google Gemini API key (never commit real keys to version control).
# Obtain a free key from Google AI Studio: https://aistudio.google.com/
VISION_API_KEY=your_api_key_here_do_not_commit

# Gemini model identifier (gemini-flash-latest or gemini-3.8-flash for rapid multimodal inference)
VISION_MODEL_NAME=gemini-flash-latest

# Upstream vision provider HTTP timeout in seconds
VISION_REQUEST_TIMEOUT_SECONDS=30.0

# Image Quality & Validation Thresholds
# Maximum upload payload size in bytes (8 MB default limit)
MAX_UPLOAD_SIZE_BYTES=8388608

# Sharpness edge-variance threshold for blur detection (8.0 balances low-light camera photos with blur detection)
BLUR_THRESHOLD=8.0

# Minimum allowed width/height in pixels
MIN_IMAGE_DIMENSION=64

# Maximum allowed width/height in pixels to prevent memory exhaustion
MAX_IMAGE_DIMENSION=8192

# Maximum total pixels to prevent Pillow decompression bombs (~25 megapixels)
MAX_IMAGE_PIXELS=25000000

# Android Client Networking Reference
# 10.0.2.2 connects from the standard Android emulator to localhost on host machine
OPTISCAN_BACKEND_URL=http://10.0.2.2:8000/
